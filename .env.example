# Создайте файл .env из копии этого файла и замените значения переменных реальными данными

# Настройки подключения к базе данных PostgreSQL

DB_NAME=headhunter_db       # Название базы данных
DB_USER=postgres            # Имя пользователя PostgreSQL
DB_PASSWORD=your_password   # Пароль пользователя
DB_HOST=localhost           # Хост базы данных
DB_PORT=5432                # Порт базы данных